{
  "name": "fluvia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fluvia \u2014 plataforma de pagos de extrema confiabilidad (Ledger de doble partida, Outbox transaccional, RLS multi-tenant)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "migrate": "pnpm --filter @fluvia/db run migrate",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,yml,yaml}\"",
    "seed": "pnpm --filter @fluvia/seeds run seed",
    "licenses:check": "node scripts/check-licenses.mjs",
    "licenses:report": "node scripts/check-licenses.mjs --report"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript-eslint": "^8.66.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@8.4.31": "^8.5.10"
    }
  }
}
