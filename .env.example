# Fluvia — variables de entorno (ver packages/config)
# En local/test todo tiene defaults que apuntan a docker-compose; NADA de esto
# es obligatorio para desarrollo. En sandbox/staging/production TODAS las URLs
# son obligatorias y distintas por entorno (proteccion anti-mezcla, V4 §43).

NODE_ENV=local
PORT=3000
LOG_LEVEL=info

# ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/fluvia
# APP_DATABASE_URL=postgres://fluvia_app:fluvia_app_dev_password@127.0.0.1:5432/fluvia
# WORKER_DATABASE_URL=postgres://fluvia_worker:fluvia_worker_dev_password@127.0.0.1:5432/fluvia
# AUTH_DATABASE_URL=postgres://fluvia_auth:fluvia_auth_dev_password@127.0.0.1:5432/fluvia
# REDIS_URL=redis://127.0.0.1:6379

# Tasas de referencia (solo equivalencias; nunca cobro ni conversión de fondos).
# Ver docs/product/tasas-referencia.md. Ninguna clave es obligatoria.
# FX_REFRESH=on                      # off en test/CI (sin red externa)
# FX_BCV_INTERVAL_SECONDS=1800       # mínimo 600
# FX_USDT_INTERVAL_SECONDS=300       # mínimo 60
# FX_COINGECKO_DEMO_API_KEY=         # opcional (plan Demo, cabecera x-cg-demo-api-key)
# FX_COINGECKO_PRO_API_KEY=          # opcional (plan de pago, pro-api.coingecko.com)
# FX_HTTP_TIMEOUT_MS=20000
# FX_MAX_ATTEMPTS=3
# FX_BACKOFF_BASE_MS=2000
