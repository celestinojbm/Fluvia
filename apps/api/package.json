{
  "name": "@fluvia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "drill:reconciliation": "tsx drills/reconciliation-drill.ts",
    "drill:disputes": "tsx drills/disputes-drill.ts",
    "drill:indeterminate": "tsx drills/indeterminate-payment-drill.ts",
    "drill:outbox-inbox": "tsx drills/outbox-inbox-stuck-drill.ts",
    "drill:worker-down": "tsx drills/worker-down-drill.ts",
    "drill:webhook-dead-letter": "tsx drills/webhook-dead-letter-drill.ts",
    "drill:restore": "tsx drills/restore-drill.ts",
    "drill:load-chaos": "tsx drills/load-chaos-drill.ts"
  },
  "dependencies": {
    "@fluvia/audit": "workspace:*",
    "@fluvia/auth": "workspace:*",
    "@fluvia/config": "workspace:*",
    "@fluvia/db": "workspace:*",
    "@fluvia/events": "workspace:*",
    "@fluvia/idempotency": "workspace:*",
    "@fluvia/identity": "workspace:*",
    "@fluvia/inbox": "workspace:*",
    "@fluvia/ledger": "workspace:*",
    "@fluvia/money": "workspace:*",
    "@fluvia/observability": "workspace:*",
    "@fluvia/outbox": "workspace:*",
    "@fluvia/payments-core": "workspace:*",
    "@fluvia/reconciliation": "workspace:*",
    "@fluvia/webhooks": "workspace:*",
    "fastify": "^5.10.0",
    "redis": "6.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
