{
  "name": "@fluvia/seeds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/run.ts",
    "showroom:seed": "tsx src/run-showroom.ts",
    "demo:reset": "tsx src/run-reset.ts"
  },
  "dependencies": {
    "@fluvia/audit": "workspace:*",
    "@fluvia/auth": "workspace:*",
    "@fluvia/config": "workspace:*",
    "@fluvia/db": "workspace:*",
    "@fluvia/identity": "workspace:*",
    "@fluvia/ledger": "workspace:*",
    "@fluvia/money": "workspace:*",
    "@fluvia/outbox": "workspace:*",
    "@fluvia/payments-core": "workspace:*",
    "@fluvia/reconciliation": "workspace:*",
    "@fluvia/webhooks": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
